<div> Sexmoves </div>

<div> 
	<input type="text" name="system.sex0.NAME" style="width: 80px;" value="{{system.sex0.NAME}}" /> 
	<select name="system.sex0.NOTES" style="width: 366px;">
  		{{selectOptions basicsexOptions selected=system.sex0.NOTES valueAttr="value" labelAttr="label"}}
	</select>
	<input type="text" name="system.sex0.DAMAGE" style="width: 60px;" value="{{system.sex0.DAMAGE}}" /> 
	<a class='rollable' 
		data-roll-type="multi"
		data-move="sex"
		data-label= "{{system.sex0.NAME}} | {{system.sex0.NOTES}}"
		data-text="Cant Miss"
		data-roll=""
		data-text2="Damage"
		data-roll2="{{system.sex0.DAMAGE}}+{{system.magTotal}}+{{system.atkTotal}}"
		data-text3="Crit"
		data-roll3="d12+{{system.preTotal}}+{{system.magTotal}}"
		data-text4="Crit Dmg"
		data-roll4="{{system.sex0.DAMAGE}}+({{system.ferTotal}}*2)"
		data-action='roll'> 
		SEX 
	</a>

	<a class='rollable' 
		data-roll-type="multi"
		data-label= "{{system.sex0.NAME}}. {{system.sex0.NOTES}}"
		data-text="Extra"
		data-roll="{{system.sex0.DAMAGE}}"
		data-text2="Quick"
		data-roll2="{{system.sex0.DAMAGE}}+{{system.sex0.DAMAGE}}"
		data-text3="Rapid"
		data-roll3="{{system.sex0.DAMAGE}}+{{system.sex0.DAMAGE}}+{{system.sex0.DAMAGE}}"
		data-text4="+1 Hit"
		data-roll4="{{system.sex0.DAMAGE}}"
		data-action='roll'> 
		HIT 
	</a>

</div>

