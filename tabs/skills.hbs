{{! Skills Tab }}
<section
  class='tab skills flexcol {{tab.cssClass}}'
  data-group='primary'
  data-tab='skills'
>

<div> Combat Skills </div>

<div> 
	<a class='rollable' data-roll-type='talk' data-action='roguelike2' data-index='1'> ? </a>
	<select name="system.skill1.TYPE" style="width: 100px;">
  		{{selectOptions skillOptions selected=system.skill1.TYPE valueAttr="value" labelAttr="label"}}
	</select>
	<input type="text" name="system.skill1.NAME" placeholder="skill 1" style="width: 100px;" value="{{system.skill1.NAME}}" /> 
	<input type="text" name="system.skill1.NOTES" placeholder="effect notes" style="width: 300px;" value="{{system.skill1.NOTES}}" />
	<a class='rollable' data-roll-type='talk' data-action='roll' 
	data-label='{{system.skill1.TYPE}} | {{system.skill1.NAME}} | {{system.skill1.NOTES}}'> SHOW </a>
</div>
