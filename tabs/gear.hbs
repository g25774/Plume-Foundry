{{! Gear Tab }}
<section class='tab gear {{tab.cssClass}}' data-group='primary' data-tab='gear'>

<div> Held Weapons </div>

<div>
	<select name="system.weapon1.HIT" style="width: 85px;">
  		{{selectOptions hitOptions selected=system.weapon1.HIT valueAttr="value" labelAttr="label"}}
	</select>
	<input type="text" name="system.weapon1.NAME" placeholder="weapon 1" style="width: 80px;" value="{{system.weapon1.NAME}}" /> 
	<input type="text" name="system.weapon1.NOTES" placeholder="keywords" style="width: 260px;" value="{{system.weapon1.NOTES}}" />
	<input type="text" name="system.weapon1.DAMAGE" style="width: 60px;" value="{{system.weapon1.DAMAGE}}" /> 
	<a class='rollable' 
		data-roll-type="multi"
		data-move="atk"
		data-label= "{{system.weapon1.NAME}}. {{system.weapon1.NOTES}}"
		data-text="Attack"
		data-roll="d12+{{system.weapon1Scaling}}+{{system.accTotal}}"
		data-text2="Damage"
		data-roll2="{{system.weapon1.DAMAGE}}+{{system.weapon1Scaling2}}+{{system.atkTotal}}"
		data-text3="Crit"
		data-roll3="d12+{{system.preTotal}}+{{system.weapon1Scaling}}"
		data-text4="Crit Dmg"
		data-roll4="{{system.weapon1.DAMAGE}}+{{system.dexTotal}}+({{system.ferTotal}}*2)"
		data-action='roll'> 
		ATTACK 
	</a>
	<span> | </span>

	<a class='rollable' 
		data-roll-type="multi"
		data-label= "{{system.weapon1.NAME}}. {{system.weapon1.NOTES}}"
		data-text="Extra"
		data-roll="{{system.weapon1.DAMAGE}}"
		data-text2="Quick"
		data-roll2="{{system.weapon1.DAMAGE}}+{{system.weapon1.DAMAGE}}"
		data-text3="Rapid"
		data-roll3="{{system.weapon1.DAMAGE}}+{{system.weapon1.DAMAGE}}+{{system.weapon1.DAMAGE}}"
		data-text4="+1 Hit"
		data-roll4="{{system.weapon1.DAMAGE}}"
		data-action='roll'> 
		HIT 
	</a>

</div>

