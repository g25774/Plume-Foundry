<div> 
	Skimpy? <input type="checkbox" name="system.cute.up" {{checked system.cute.up}} > 
	<input type="text" name="system.armor.NAME" placeholder="armor" value="{{system.armor.NAME}}" style="width: 160px;" /> 
	<input type="text" name="system.armor.NOTES" placeholder="armor notes" style="width: 260px;" value="{{system.armor.NOTES}}"/>
	Cute? <input type="checkbox" name="system.cute.yes" {{checked system.cute.yes}} >
	<a class='rollable' data-roll-type='scan' data-action='roll' 
	data-label= '{{system.armor.NAME}} | {{system.armor.NOTES}}'
	data-roll='{{system.healthTotal}}' data-text='HEALTH'
	data-roll2='{{system.spiritTotal}}' data-text2='SPIRIT'
	data-roll3='{{system.cuteTotal}}' data-text3='CUTE'
	data-roll4='{{system.evasionTotal}}' data-text4='EVA'
	data-roll5='{{system.gripDC}}' data-text5='GRIP'
	> SHOW </a>
</div>

